<?xml version="1.0" ?>
<!-- 导航 bringup 验证用的小场地：8m x 6m 围墙 + 三个障碍物。
     全部用基础几何体，不依赖 gazebosim.org 在线模型库。 -->
<sdf version="1.6">
  <gui fullscreen="0">
    <camera name="user_camera">
      <pose>2.5 -2.5 2.0 0 0.55 2.356</pose>
    </camera>
  </gui>
  <world name="default">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ==================== 围墙 ==================== -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 3.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.24 0.12 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.24 0.12 1.2</size></box></geometry>
          <material><ambient>0.2 0.3 0.6 1</ambient><diffuse>0.3 0.4 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -3.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.24 0.12 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.24 0.12 1.2</size></box></geometry>
          <material><ambient>0.2 0.3 0.6 1</ambient><diffuse>0.3 0.4 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>4.0 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 6.12 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 6.12 1.2</size></box></geometry>
          <material><ambient>0.2 0.3 0.6 1</ambient><diffuse>0.3 0.4 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-4.0 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 6.12 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 6.12 1.2</size></box></geometry>
          <material><ambient>0.2 0.3 0.6 1</ambient><diffuse>0.3 0.4 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== 障碍物 ==================== -->
    <model name="box_a">
      <static>true</static>
      <pose>2.0 1.2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.6 1.0</size></box></geometry>
          <material><ambient>0.7 0.2 0.2 1</ambient><diffuse>0.8 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_b">
      <static>true</static>
      <pose>-1.5 -1.2 0.4 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 1.8 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 1.8 0.8</size></box></geometry>
          <material><ambient>0.2 0.6 0.2 1</ambient><diffuse>0.3 0.7 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="cyl_a">
      <static>true</static>
      <pose>1.0 -1.8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.6 0.5 0.1 1</ambient><diffuse>0.7 0.6 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- 发布 /model_states 真值，用于建图质量量化 -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <update_rate>20.0</update_rate>
    </plugin>

  </world>
</sdf>
